# Copy this file to .env (or .env.local) and fill in real values there.
# .env / .env.local are git-ignored — never commit real secrets.

# GEMINI_API_KEY: Optional. Enables live Gemini AI calls (server-side only —
# never sent to the browser). Without it, the AI endpoints run in a
# deterministic fallback mode instead of calling Gemini.
GEMINI_API_KEY=""

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# JWT_SECRET / CSRF_SECRET: Long random strings used to sign session and
# CSRF tokens. If left blank, the server generates a fresh random secret on
# every boot (fine for local dev, but sessions won't survive a restart, and
# multiple server instances won't be able to validate each other's tokens).
# Generate one with: openssl rand -hex 32
JWT_SECRET=""
CSRF_SECRET=""

# ADMIN_INITIAL_PASSWORD / ANALYST_INITIAL_PASSWORD / VIEWER_INITIAL_PASSWORD:
# Passwords for the three seeded operator accounts (Admin/Analyst/Viewer).
# Required (12+ characters) in production — if unset, the app no longer
# falls back to a hardcoded password; that account is simply left
# unprovisioned and login for it will fail until you set this.
# In local development only, leaving these unset generates a random
# temporary password printed once to your terminal on boot.
ADMIN_INITIAL_PASSWORD=""
ANALYST_INITIAL_PASSWORD=""
VIEWER_INITIAL_PASSWORD=""

# TOOL_ENCRYPTION_KEY: 32-byte (64 hex char) key used to encrypt connected
# security-tool API keys (VirusTotal, OTX, Shodan, AbuseIPDB, ...) at rest.
# Required in production. Generate one with: openssl rand -hex 32
TOOL_ENCRYPTION_KEY=""

# ALLOWED_ORIGINS: Comma-separated list of origins allowed to call the API
# with credentials (cookies). Only needed if the frontend and API are ever
# served from different origins; same-origin requests work without this.
# Example: ALLOWED_ORIGINS="https://app.example.com,https://staging.example.com"
ALLOWED_ORIGINS=""

# ALLOW_DEMO_BOOTSTRAP: Leave unset/false for any deployment with real data.
# When true, unauthenticated visitors are auto-signed-in as the Analyst demo
# account with no password — this is a real credential-bypass and should
# only ever be enabled for a deliberately public, no-real-data demo
# deployment. It is always allowed in local development regardless of this
# flag (NODE_ENV !== 'production').
ALLOW_DEMO_BOOTSTRAP="false"

# Optional external sandbox integration status. NEXSUS never executes samples
# locally; both values must be HTTPS URLs for the isolated service boundary to
# be reported as configured. An approved adapter is still required before any
# execution telemetry is accepted.
SANDBOX_API_URL=""
SANDBOX_HEALTH_URL=""
