# ---- App ----
APP_NAME=CyberResearch-X Enterprise (nexsus)
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://nexsus:nexsus@localhost:5432/nexsus
SYNC_DATABASE_URL=postgresql+psycopg2://nexsus:nexsus@localhost:5432/nexsus

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Auth ----
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---- AI Providers (no keys committed) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Threat intel sources (Phase 3 — Threat Intelligence Agent) ----
# Every source below is optional. Missing keys degrade gracefully: the
# Threat Intelligence Agent reports "not_configured" per source instead of
# failing the pipeline.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# ---- Storage ----
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=25

# ---- Future components ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
QDRANT_URL=http://localhost:6333

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
